{"recipes": [
  
{"id": "talk.visitor.hire",
"label": "Embaucher un Visiteur",
"actionid": "talk",
"startdescription": "Je vais embaucher celui-ci pour une journée.",
"desc": "Embauché.",
"reqs": {"fee":1,"pence":"fee","assistance":-1},
"aspects":{"recruiting":1},
"effects":{"pence":"-fee"},
"comments":"The employable is hired before their fee is paid! Which is OK as long as we specify their fee on their assistance version, too. This may also allow us to extend employment.",
"warmup":5,
"craftable":true},


{"id": "talk.visitor.hire.hint",
"label": "Embaucher un Visiteur?",
"actionid": "talk",
"startdescription": "Si je respecte leur prix, je peux les embaucher pour une journée.",
"reqs": {"fee":1,"assistance":-1},
"hintonly":true},


  {"id": "talk.visitor.show.slot.generic",

  "actionid": "talk",
  "startdescription": "Je peux identifier les intérêts de mes visiteurs et les satisfaire avec un livre approprié. Alternativement, s'ils connaissent une langue que j'aimerais apprendre, je peux proposer un paiement. [Des visiteurs peu fiables peuvent occasionnellement s'enfuir avec un livre]",
  "desc": "Mon visiteur n'a rien appris.",
  "reqs": {"visitor":1,"incident":-1},
"slots": [{
      "id": "v",
      "label":"Donner ou prendre",
      "required": {"readable":1,"tally":1},
      "description":"Un livre qui correspond à leurs intérêts - ou une spintria pour payer leurs services."
        }],
  "effects":{},
  "warmup":60,
  "alt":[{"id":"talk.visitor.payment.*"},
  {"id":"talk.visitor.intercept.*"},  
  {"id":"talk.visitor.cantread.*"},
  {"id":"talk.visitor.consultation.*"}]},

  
